{
  "name": "@crayonz-ai/sdk",
  "version": "0.2.1",
  "description": "Official TypeScript SDK for the Crayonz AI API — print-ready AI design generation, garment mockups, model/product photoshoots, and virtual try-on.",
  "license": "MIT",
  "homepage": "https://crayonz.ai/api-console",
  "repository": {
    "type": "git",
    "url": "https://github.com/iitian-vibes/crayonz-sdks.git",
    "directory": "typescript"
  },
  "keywords": ["crayonz", "ai", "design-generation", "print-on-demand", "virtual-try-on", "mockups"],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.2"
  }
}
